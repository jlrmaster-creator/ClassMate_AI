rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validTimestamp(value) {
      return value is timestamp;
    }

    function isRoomMember(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/roomMemberships/$(roomId));
    }

    function isProjectMember(projectId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/projectMemberships/$(projectId));
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.id == userId
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isOwner(userId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isOwner(userId);

      match /subjects/{subjectId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && validTimestamp(request.resource.data.createdAt)
          && validTimestamp(request.resource.data.updatedAt);
        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.createdAt == resource.data.createdAt
          && validTimestamp(request.resource.data.updatedAt);
        allow delete: if isOwner(userId);
      }

      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.status in ['pending', 'in_progress', 'completed']
          && request.resource.data.priority in ['low', 'medium', 'high']
          && validTimestamp(request.resource.data.createdAt)
          && validTimestamp(request.resource.data.updatedAt);
        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.createdAt == resource.data.createdAt
          && validTimestamp(request.resource.data.updatedAt);
        allow delete: if isOwner(userId);
      }

      match /timetable/{slotId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.subject is string
          && request.resource.data.subject.size() > 0
          && request.resource.data.subject.size() <= 80
          && validTimestamp(request.resource.data.createdAt)
          && validTimestamp(request.resource.data.updatedAt);
        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.createdAt == resource.data.createdAt
          && validTimestamp(request.resource.data.updatedAt);
        allow delete: if isOwner(userId);
      }

      match /projects/{projectId} {
        allow read: if isOwner(userId) || isProjectMember(projectId);
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.ownerId == userId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.code is string
          && request.resource.data.code.size() == 6
          && request.resource.data.collaboratorIds is list
          && validTimestamp(request.resource.data.createdAt)
          && validTimestamp(request.resource.data.updatedAt);
        allow update: if (isOwner(userId) || isProjectMember(projectId))
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.code == resource.data.code
          && request.resource.data.createdAt == resource.data.createdAt
          && validTimestamp(request.resource.data.updatedAt);
        allow delete: if isOwner(userId);

        match /subtasks/{subtaskId} {
          allow read, create, update, delete: if isOwner(userId) || isProjectMember(projectId);
        }
      }

      match /projectMemberships/{projectId} {
        allow read, write: if isOwner(userId);
      }

      match /studySessions/{sessionId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && validTimestamp(request.resource.data.createdAt)
          && validTimestamp(request.resource.data.updatedAt);
        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.createdAt == resource.data.createdAt
          && validTimestamp(request.resource.data.updatedAt);
      }

      match /notifications/{notificationId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.userId == userId;
      }

      match /settings/{settingsId} {
        allow read, write: if isOwner(userId);
      }

      match /roomMemberships/{roomId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.roomId == roomId;
        allow update, delete: if isOwner(userId);
      }
    }

    match /rooms/{roomId} {
      allow read: if isRoomMember(roomId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.code is string
        && request.resource.data.code.size() == 6
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.memberIds.hasOnly([request.auth.uid])
        && validTimestamp(request.resource.data.createdAt)
        && validTimestamp(request.resource.data.updatedAt);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberIds'])
        && request.resource.data.memberIds.hasAny([request.auth.uid]);
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /presence/{memberId} {
        allow read: if isRoomMember(roomId);
        allow write: if signedIn() && request.auth.uid == memberId;
      }
    }

    match /roomCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.roomId is string
        && request.resource.data.name is string;
    }

    match /projectCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.projectId is string
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/projects/$(request.resource.data.projectId));
    }

    match /timetableShares/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.slots is list
        && request.resource.data.slots.size() > 0
        && request.resource.data.slots.size() <= 60
        && validTimestamp(request.resource.data.createdAt)
        && validTimestamp(request.resource.data.updatedAt);
      allow update, delete: if false;
    }
  }
}
